generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexión directa (sin pooler) para migraciones. En local puede ser igual a DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  displayName  String
  bio          String   @default("")
  avatarUrl    String   @default("")
  bannerUrl    String   @default("")
  theme        String   @default("creador")
  // Personalización encima del tema ("" = usar el del tema)
  colorButton     String @default("")
  colorButtonText String @default("")
  colorText       String @default("")
  colorBg         String @default("")
  colorBg2        String @default("")
  buttonShape     String @default("")
  buttonFill      String @default("")
  font            String @default("")
  // Contacto (empresas y tiendas); vacío = no se muestra
  contactPhone    String @default("")
  contactWhatsapp String @default("")
  contactEmail    String @default("")
  contactAddress  String @default("")
  contactHours    String @default("")
  createdAt    DateTime @default(now())
  verified     Boolean  @default(false)
  suspended    Boolean  @default(false)
  links        Link[]
  events       Event[]
  reports      Report[]
}

model Link {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  title     String
  url       String
  position  Int      @default(0)
  active    Boolean  @default(true)
  display   String   @default("button") // "button" | "icon"
  highlight Boolean  @default(false)
  kind      String   @default("link") // "link" | "product"
  price     String   @default("")
  thumbnailUrl String @default("")
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, position])
}

// Límite de intentos (login, registro…) por clave: "login:ip:<hash>", "login:email:<email>"…
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// Visitas a la página y clics en enlaces, para las estadísticas (sin IPs ni datos personales)
model Event {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkId    String?
  type      String // "view" | "click"
  country   String   @default("")
  device    String   @default("")
  source    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Reportes de perfiles hechos por visitantes
model Report {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  details   String   @default("")
  status    String   @default("open") // "open" | "resolved"
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// Dominios bloqueados por la administración (además de la lista incorporada)
model BlockedDomain {
  host      String   @id
  note      String   @default("")
  createdAt DateTime @default(now())
}
